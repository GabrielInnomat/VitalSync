<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <TargetFramework>net10.0</TargetFramework>
    <VitalSyncAnalyzersProject>$(MSBuildThisFileDirectory)tools/VitalSync.Analyzers/VitalSync.Analyzers.csproj</VitalSyncAnalyzersProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'VitalSync.Analyzers'">
    <ProjectReference Include="$(VitalSyncAnalyzersProject)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      IsAspireProjectResource="false" />
    <AdditionalFiles Include="**/*.css;**/*.js" Exclude="bin/**;obj/**" />
  </ItemGroup>

</Project>
