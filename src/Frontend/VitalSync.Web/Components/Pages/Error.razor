@page "/Error"
@using System.Diagnostics

<PageTitle>Fehler · VitalSync</PageTitle>

<h1 class="text-danger">Fehler</h1>
<h2 class="text-danger">Beim Verarbeiten deiner Anfrage ist ein Fehler aufgetreten.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Anfrage-ID:</strong> <code>@requestId</code>
    </p>
}

<h3>Entwicklungsmodus</h3>
<p>
    In der Umgebung <strong>Development</strong> werden genauere Angaben zum aufgetretenen Fehler angezeigt.
</p>
<p>
    <strong>In ausgelieferten Anwendungen darf die Umgebung Development nicht aktiviert sein.</strong>
    Sonst können Endnutzer sensible Informationen aus Ausnahmen sehen.
    Für das lokale Debugging die Umgebungsvariable <strong>ASPNETCORE_ENVIRONMENT</strong> auf <strong>Development</strong> setzen
    und die Anwendung neu starten.
</p>

@code{
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
