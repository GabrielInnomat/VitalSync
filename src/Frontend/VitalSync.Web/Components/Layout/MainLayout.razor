@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">Über ASP.NET Core</a>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    <span class="error-message">Ein unerwarteter Fehler ist aufgetreten.</span>
    <a href="" class="reload">Neu laden</a>
    <button type="button" class="dismiss">Schliessen</button>
</div>
