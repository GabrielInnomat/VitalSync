@namespace VitalSync.DesignSystem.Patterns.Overlays
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_element"
        @attributes="AdditionalAttributes"
        class="@CssClass"
        role="@Role"
        aria-labelledby="@(Open ? TitleId : null)"
        aria-describedby="@(Open && Confirmation ? ContentId : null)">
    @if (Open)
    {
        <div class="vs-dialog__header">
            <h2 id="@TitleId" class="vs-dialog__title" tabindex="-1">@Title</h2>
            @if (!Confirmation)
            {
                <button type="button" class="vs-dialog__close" @onclick="RequestClose">
                    <span class="vs-dialog__close-icon" aria-hidden="true">
                        <SystemIcon Name="SystemIconName.X" />
                    </span>
                    <span class="vs-dialog__close-name">Schliessen</span>
                </button>
            }
        </div>
        <div class="vs-dialog__body">
            <div id="@ContentId" class="vs-dialog__content">@ChildContent</div>
        </div>
        @if (Footer is not null)
        {
            <div class="vs-dialog__footer">@Footer</div>
        }
    }
</dialog>

@code {
    private const string ModulePath = "./_content/VitalSync.DesignSystem/Patterns/Overlays/DialogFrame.razor.js";

    private readonly string _id = $"vs-dialog-{Guid.NewGuid():N}";
    private ElementReference _element;
    private Task<IJSObjectReference>? _module;
    private DotNetObjectReference<DialogFrame>? _self;
    private bool _shown;

    [Parameter]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public bool Confirmation { get; set; }

    [Parameter]
    public bool Fullscreen { get; set; }

    [Parameter]
    public EventCallback OnRequestClose { get; set; }

    [Parameter]
    public Func<ElementReference>? CloseFocusTarget { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleId => $"{_id}-title";

    private string ContentId => $"{_id}-content";

    private string? Role => Confirmation ? "alertdialog" : null;

    private string Size => Confirmation ? "small" : Fullscreen ? "fullscreen" : "medium";

    private string CssClass => CssClasses.Merge($"vs-dialog vs-dialog--{Size}", AdditionalAttributes);

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title))
        {
            throw new InvalidOperationException(
                "A dialog requires a Title; it names the dialog for everyone, including screen readers.");
        }

        if (ChildContent is null)
        {
            throw new InvalidOperationException(
                "A dialog requires ChildContent; a dialog without content has nothing to ask or show.");
        }

        if (Confirmation && Fullscreen)
        {
            throw new InvalidOperationException(
                "A confirmation is always small; only the ordinary dialog can be shown full screen.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _shown = Open;
        _module ??= JS.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask();
        var module = await _module.ConfigureAwait(true);

        if (Open)
        {
            _self ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("open", _element, _self).ConfigureAwait(true);
        }
        else
        {
            await module.InvokeVoidAsync("close", _element, CloseFocusTarget?.Invoke()).ConfigureAwait(true);
        }
    }

    [JSInvokable]
    public Task RequestClose() => OnRequestClose.InvokeAsync();

    [JSInvokable]
    public async Task ClosedByBrowser()
    {
        _shown = false;
        await OnRequestClose.InvokeAsync().ConfigureAwait(true);
        await InvokeAsync(StateHasChanged).ConfigureAwait(true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                var module = await _module.ConfigureAwait(true);

                if (_shown)
                {
                    await module.InvokeVoidAsync("dispose", _element).ConfigureAwait(true);
                }

                await module.DisposeAsync().ConfigureAwait(true);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
        GC.SuppressFinalize(this);
    }
}
