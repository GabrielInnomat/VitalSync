@namespace VitalSync.DesignSystem.Patterns.Navigation
@using System.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div @attributes="AdditionalAttributes" class="@CssClass">
    <div @ref="_list" class="vs-tabs__list" role="tablist" aria-label="@Label">
        @foreach (var tab in _tabs)
        {
            var selected = IsSelected(tab.Key);
            <a id="@tab.TabId"
               class="vs-tabs__tab"
               role="tab"
               href="@Navigation.GetUriWithQueryParameter(QueryName, tab.Key)"
               aria-selected="@(selected ? "true" : "false")"
               aria-controls="@tab.PanelId"
               tabindex="@TabIndex(selected)"
               data-vs-tab-key="@tab.Key">
                @if (tab.Icon is not null)
                {
                    <span class="vs-tabs__icon" aria-hidden="true">@tab.Icon</span>
                }
                <span class="vs-tabs__title" data-text="@tab.Title">@tab.Title</span>
                @if (tab.Badge is not null)
                {
                    <span class="vs-tabs__badge">@tab.Badge</span>
                }
                @if (tab.BadgeDescription is not null)
                {
                    <span class="vs-tabs__hidden">@tab.BadgeDescription</span>
                }
            </a>
        }
    </div>
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
        @RegistrationSentinel
    </CascadingValue>
</div>

@code {
    private const string ModulePath = "./_content/VitalSync.DesignSystem/Patterns/Navigation/Tabs.razor.js";
    private const int MinimumTabs = 2;
    private const int MaximumTabs = 5;

    private readonly List<Tab> _tabs = [];
    private ElementReference _list;
    private Task<IJSObjectReference>? _module;
    private DotNetObjectReference<Tabs>? _self;
    private bool _complete;
    private bool _disposed;
    private bool _parametersSeen;
    private string? _lastActive;
    private string? _selected;
    private string? _queryKey;
    private string? _syncedKey;

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Active { get; set; }

    [Parameter]
    public EventCallback<string?> ActiveChanged { get; set; }

    [Parameter]
    public string QueryName { get; set; } = "tab";

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private static readonly RenderFragment RegistrationSentinel = builder =>
    {
        builder.OpenComponent<TabsRegistration>(0);
        builder.CloseComponent();
    };

    private string CssClass => CssClasses.Merge("vs-tabs", AdditionalAttributes);

    private string SelectedKey => Existing(_selected) ?? Existing(_queryKey) ?? Existing(Active) ?? FirstKey;

    private string FirstKey => _tabs.Count > 0 ? _tabs[0].Key : "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(QueryName))
        {
            throw new InvalidOperationException(
                "Tabs require a QueryName; it keeps the selected tab in the address.");
        }

        _queryKey = HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)[QueryName];
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException(
                "Tabs require a Label; it names the row of tabs for screen readers.");
        }

        if (ChildContent is null)
        {
            throw new InvalidOperationException("Tabs require ChildContent with two to five Tab components.");
        }

        if (!_parametersSeen)
        {
            _parametersSeen = true;
            _lastActive = Active;
        }
        else if (!string.Equals(Active, _lastActive, StringComparison.Ordinal))
        {
            _lastActive = Active;
            _selected = Active;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_complete || !RendererInfo.IsInteractive)
        {
            return;
        }

        var key = SelectedKey;

        if (_module is null)
        {
            _syncedKey = key;
            _module = JS.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask();
            _self = DotNetObjectReference.Create(this);
            var attachModule = await _module.ConfigureAwait(true);
            await attachModule.InvokeVoidAsync("attach", _list, _self).ConfigureAwait(true);

            if (!string.Equals(Active, key, StringComparison.Ordinal))
            {
                _selected = key;
                _lastActive = key;
                await ActiveChanged.InvokeAsync(key).ConfigureAwait(true);
            }

            return;
        }

        if (!string.Equals(key, _syncedKey, StringComparison.Ordinal))
        {
            _syncedKey = key;
            var module = await _module.ConfigureAwait(true);
            await module.InvokeVoidAsync("replaceUrl", QueryName, key).ConfigureAwait(true);
        }
    }

    [JSInvokable]
    public async Task Select(string key)
    {
        if (Existing(key) is null || IsSelected(key))
        {
            return;
        }

        _selected = key;
        _lastActive = key;
        await ActiveChanged.InvokeAsync(key).ConfigureAwait(true);
        await InvokeAsync(StateHasChanged).ConfigureAwait(true);
    }

    internal bool IsSelected(string key) => string.Equals(key, SelectedKey, StringComparison.Ordinal);

    internal void Register(Tab tab)
    {
        if (_tabs.Count == MaximumTabs)
        {
            throw new InvalidOperationException(
                $"Tabs hold at most {MaximumTabs} tabs; more no longer fit on a phone.");
        }

        if (Existing(tab.Key) is not null)
        {
            throw new InvalidOperationException($"Two tabs share the key '{tab.Key}'; every key must be unique.");
        }

        _tabs.Add(tab);

        if (_complete)
        {
            StateHasChanged();
        }
    }

    internal void Unregister(Tab tab)
    {
        if (_tabs.Remove(tab) && !_disposed)
        {
            StateHasChanged();
        }
    }

    internal void Refresh() => StateHasChanged();

    internal void Complete()
    {
        _complete = true;

        if (_tabs.Count < MinimumTabs)
        {
            throw new InvalidOperationException(
                $"Tabs need at least {MinimumTabs} tabs; a single view needs no tabs.");
        }

        StateHasChanged();
    }

    private string? Existing(string? key) =>
        key is not null && _tabs.Exists(tab => string.Equals(tab.Key, key, StringComparison.Ordinal)) ? key : null;

    private string? TabIndex(bool selected) =>
        RendererInfo.IsInteractive ? selected ? "0" : "-1" : null;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_module is not null)
        {
            try
            {
                var module = await _module.ConfigureAwait(true);
                await module.InvokeVoidAsync("detach", _list).ConfigureAwait(true);
                await module.DisposeAsync().ConfigureAwait(true);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
        GC.SuppressFinalize(this);
    }
}
