@page "/design-system/data-table"
@layout GalleryLayout
@rendermode InteractiveServer

<PageTitle>Datentabelle · Design System · VitalSync</PageTitle>

<h1>Datentabelle (<code>DataTable</code>, <code>DataTableColumn</code>, <code>DataTableTemplateColumn</code>)</h1>
<p>
    Eine Datentabelle ist eine Tabelle, die man filtern, sortieren und blättern kann. Jede filterbare
    Spalte hat ein eigenes Suchfeld; alle Filter gelten zusammen. Text wird als Teil gesucht, Zahlen
    und Daten verstehen Vergleiche wie <code>&lt;50</code> und Bereiche wie <code>10-20</code>.
    Gefiltert wird 800 ms nach dem letzten Tastendruck, mit Enter oder beim Verlassen des Felds sofort.
    Sortierung, Filter und Seite stehen in der Adresse, ein Link führt also genau hierher zurück. Die
    Begründungen stehen in
    <a href="https://github.com/GabrielInnomat/VitalSync/blob/main/docs/design-system/data.md#data-table">docs/design-system/data.md</a>.
</p>

<div class="vs-gallery__themes">
    @foreach (var demo in _themes)
    {
        <section data-theme="@demo.Theme" class="vs-gallery__theme-panel">
            <h2>@demo.Title</h2>

            <h3>Auf der Seite</h3>
            @RenderFoods($"{demo.Theme}-seite")

            <h3>In einer Card</h3>
            <div class="vs-data-table-gallery__card">
                @RenderFoods($"{demo.Theme}-card")
            </div>

            <h3>Vom Server</h3>
            <p>Die Zeilen kommen seitenweise von einem Dienst, der hier eine halbe Sekunde braucht.</p>
            <DataTable TItem="Food" ItemsProvider="LoadFoodsAsync" Caption="Lebensmittel im Katalog" QueryName="@($"{demo.Theme}-server")">
                <DataTableColumn Title="Lebensmittel" Value="food => food.Name" Key="name" Sortable="true" Filterable="true" />
                <DataTableColumn Title="Energie (kcal)" Value="food => food.Energy" Key="energy" Sortable="true" Filterable="true" />
                <DataTableColumn Title="Erfasst am" Value="food => food.Added" Key="added" Sortable="true" Filterable="true" />
            </DataTable>

            <h3>Wenig Platz</h3>
            <div class="vs-gallery__narrow">
                @RenderFoods($"{demo.Theme}-schmal")
            </div>
        </section>
    }
</div>

<h2>Verwendung</h2>
<pre><code>&lt;DataTable Items="foods" Caption="Nährwerte pro 100 g" QueryName="foods"&gt;
    &lt;DataTableColumn Title="Lebensmittel" Value="food =&gt; food.Name" Key="name" Sortable="true" Filterable="true" /&gt;
    &lt;DataTableColumn Title="Energie (kcal)" Value="food =&gt; food.Energy" Key="energy" Sortable="true" Filterable="true" /&gt;
    &lt;DataTableColumn Title="Erfasst am" Value="food =&gt; food.Added" Key="added" Sortable="true" Filterable="true" /&gt;
    &lt;DataTableTemplateColumn Title="Bewertung"&gt;
        &lt;Badge Variant="BadgeVariant.Success"&gt;Im Ziel&lt;/Badge&gt;
    &lt;/DataTableTemplateColumn&gt;
&lt;/DataTable&gt;

&lt;DataTable ItemsProvider="LoadFoodsAsync" Caption="Lebensmittel im Katalog" QueryName="catalog"&gt;
    &lt;DataTableColumn Title="Lebensmittel" Value="food =&gt; food.Name" Key="name" Sortable="true" Filterable="true" /&gt;
&lt;/DataTable&gt;

async ValueTask&lt;DataTableResult&lt;Food&gt;&gt; LoadFoodsAsync(DataTableRequest request, CancellationToken cancellationToken)
{
    var page = await catalog.SearchAsync(request.Filters, request.Sort, request.Skip, request.PageSize, cancellationToken);
    return new DataTableResult&lt;Food&gt;(page.Items, page.TotalCount);
}
</code></pre>

