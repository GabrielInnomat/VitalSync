    private static RenderFragment RenderFoods(string queryName) =>
        @<DataTable Items="Foods" Caption="Nährwerte pro 100 g" QueryName="@queryName">
            <DataTableColumn Title="Lebensmittel" Value="food => food.Name" Key="name" Sortable="true" Filterable="true" />
            <DataTableColumn Title="Energie (kcal)" Value="food => food.Energy" Key="energy" Sortable="true" Filterable="true" />
            <DataTableColumn Title="Eiweiss (g)" Value="food => food.Protein" Key="protein" Sortable="true" Filterable="true" />
            <DataTableColumn Title="Erfasst am" Value="food => food.Added" Key="added" Sortable="true" Filterable="true" />
            <DataTableTemplateColumn Title="Bewertung">
                @if (context.InTarget)
                {
                    <Badge Variant="BadgeVariant.Success">Im Ziel</Badge>
                }
                else
                {
                    <Badge Variant="BadgeVariant.Warning">Viel Zucker oder Fett</Badge>
                }
            </DataTableTemplateColumn>
        </DataTable>;

    private static async ValueTask<DataTableResult<Food>> LoadFoodsAsync(
        DataTableRequest request,
        CancellationToken cancellationToken)
    {
        await Task.Delay(TimeSpan.FromMilliseconds(500), cancellationToken).ConfigureAwait(true);
        IEnumerable<Food> foods = Foods;

        foreach (var filter in request.Filters)
        {
            foods = filter switch
            {
                DataTableTextFilter { Key: "name" } text =>
                    foods.Where(food => food.Name.Contains(text.Text, StringComparison.CurrentCultureIgnoreCase)),
                DataTableNumberFilter { Key: "energy" } number => foods.Where(food => number.Range.Contains(food.Energy)),
                DataTableDateFilter { Key: "added" } date => foods.Where(food => date.Range.Contains(food.Added)),
                _ => foods,
            };
        }

        foods = request.Sort switch
        {
            { Key: "name", Descending: false } => foods.OrderBy(food => food.Name, StringComparer.CurrentCultureIgnoreCase),
            { Key: "name", Descending: true } => foods.OrderByDescending(food => food.Name, StringComparer.CurrentCultureIgnoreCase),
            { Key: "energy", Descending: false } => foods.OrderBy(food => food.Energy),
            { Key: "energy", Descending: true } => foods.OrderByDescending(food => food.Energy),
            { Key: "added", Descending: false } => foods.OrderBy(food => food.Added),
            { Key: "added", Descending: true } => foods.OrderByDescending(food => food.Added),
            _ => foods,
        };

        var all = foods.ToList();
        return new DataTableResult<Food>([.. all.Skip(request.Skip).Take(request.PageSize)], all.Count);
    }

    private sealed record Food(string Name, int Energy, decimal Protein, DateOnly Added, bool InTarget);

    private sealed class ThemeDemo(string theme, string title)
    {
        public string Theme { get; } = theme;

        public string Title { get; } = title;
    }
