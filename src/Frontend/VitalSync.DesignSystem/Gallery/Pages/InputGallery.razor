@page "/design-system/input"
@layout GalleryLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Eingabefeld · Design System · VitalSync</PageTitle>

<h1>Eingabefeld (<code>Input</code>)</h1>
<p>
    Eine einzige generische Komponente, gebunden an einen <code>EditContext</code>.
    <code>Label</code> ist Pflicht – Felder ohne Beschriftung werden nicht unterstützt. Es gibt
    keine Grössenvarianten. Fehler werden immer über Rahmen, Symbol und Text zugleich angezeigt,
    nie nur über die Farbe. Ein Feld wird zum ersten Mal beim Verlassen geprüft, danach live
    während der Eingabe. Innerhalb eines <a href="design-system/form"><code>Form</code></a>
    meldet sich das Feld selbst an. Die Begründungen stehen in
    <a href="https://github.com/GabrielInnomat/VitalSync/blob/main/docs/design-system.md">docs/design-system.md</a>.
</p>

<div class="vs-gallery__themes">
    @foreach (var demo in _themes)
    {
        <section data-theme="@demo.Theme" class="vs-gallery__theme-panel">
            <h2>@demo.Title</h2>

            <h3>Formular</h3>
            <Form Model="demo.Form" OnValidSubmit="demo.MarkSubmitted">
                <DataAnnotationsValidator />

                <Input TValue="string" @bind-Value="demo.Form.Name" Label="Name" Required="true" HelperText="Wie du angesprochen werden möchtest." autocomplete="name" />

                <VitalSync.DesignSystem.Primitives.Inputs.Input TValue="int?" @bind-Value="demo.Form.WeightKg" Label="Gewicht" Type="number" Placeholder="0">
                    <Suffix>kg</Suffix>
                </VitalSync.DesignSystem.Primitives.Inputs.Input>

                <Input TValue="string" @bind-Value="demo.Form.Password" Label="Passwort" Type="password" Required="true" autocomplete="current-password" />

                <Button Variant="ButtonVariant.Primary" Type="submit">Absenden</Button>

                <p role="status" class="vs-gallery__status">@(demo.Submitted ? "Gesendet." : null)</p>
            </Form>

            <h3>Zustände</h3>
            <Form EditContext="demo.States">
                <Input TValue="string" @bind-Value="demo.StatesModel.Email" Label="E-Mail" Type="email" Required="true" autocomplete="off" />

                <VitalSync.DesignSystem.Primitives.Inputs.Input TValue="decimal?" @bind-Value="demo.StatesModel.Price" Label="Preis" Type="number" HelperText="Preis pro Packung.">
                    <Prefix>CHF</Prefix>
                </VitalSync.DesignSystem.Primitives.Inputs.Input>

                <Input TValue="string" @bind-Value="demo.StatesModel.Locked" Label="Konto" Disabled="true" HelperText="Kann nicht geändert werden." />
            </Form>
        </section>
    }
</div>

<h2>Verwendung</h2>
<pre><code>&lt;Form Model="model" OnValidSubmit="Save"&gt;
    &lt;DataAnnotationsValidator /&gt;

    &lt;Input @@bind-Value="model.Name" Label="Name" Required="true" autocomplete="name" /&gt;

    &lt;Input @@bind-Value="model.WeightKg" Label="Gewicht" Type="number"&gt;
        &lt;Suffix&gt;kg&lt;/Suffix&gt;
    &lt;/Input&gt;

    &lt;Input @@bind-Value="model.Password" Label="Passwort" Type="password" Required="true" autocomplete="current-password" /&gt;
&lt;/Form&gt;
</code></pre>

@code {
    private readonly ThemeDemo[] _themes = [new("light", "Hell"), new("dark", "Dunkel")];

    private sealed class ThemeDemo
    {
        public ThemeDemo(string theme, string title)
        {
            Theme = theme;
            Title = title;
            States = new EditContext(StatesModel);
            var messages = new ValidationMessageStore(States);
            messages.Add(States.Field(nameof(StatesDemoModel.Email)), "Bitte gib eine gültige E-Mail-Adresse ein.");
        }

        public string Theme { get; }

        public string Title { get; }

        public DemoModel Form { get; } = new();

        public StatesDemoModel StatesModel { get; } = new();

        public EditContext States { get; }

        public bool Submitted { get; private set; }

        public void MarkSubmitted() => Submitted = true;
    }

    private sealed class DemoModel
    {
        [Required(ErrorMessage = "Bitte gib einen Namen ein.")]
        public string? Name { get; set; }

        [Range(0, 300, ErrorMessage = "Bitte gib ein plausibles Gewicht ein.")]
        public int? WeightKg { get; set; }

        [Required(ErrorMessage = "Bitte gib ein Passwort ein.")]
        public string? Password { get; set; }
    }

    private sealed class StatesDemoModel
    {
        public string? Email { get; set; } = "alex@";

        public decimal? Price { get; set; } = 4.5m;

        public string? Locked { get; set; } = "alex@example.ch";
    }
}