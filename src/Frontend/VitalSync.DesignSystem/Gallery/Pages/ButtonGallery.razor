@page "/design-system/button"
@layout GalleryLayout
@rendermode InteractiveServer
@using VitalSync.DesignSystem.Primitives

<PageTitle>Schaltfläche · Design System · VitalSync</PageTitle>

<h1>Schaltfläche (<code>Button</code>)</h1>
<p>
    Drei Varianten: <code>Primary</code> für die Hauptaktion, <code>Secondary</code> für eine
    weniger betonte Aktion, <code>Critical</code> für eine zerstörende. Es gibt keine
    <code>Danger</code>-Variante und keine Grössenvarianten – die Begründungen stehen in
    <a href="https://github.com/GabrielInnomat/VitalSync/blob/main/docs/design-system.md">docs/design-system.md</a>.
    Schaltflächen nur mit Symbol werden nicht unterstützt: <code>Icon</code> ohne Beschriftung
    löst eine Ausnahme aus.
</p>

<div class="vs-gallery__themes">
    <section data-theme="light" class="vs-gallery__theme-panel">
        <h2>Hell</h2>
        @renderStates()
    </section>
    <section data-theme="dark" class="vs-gallery__theme-panel">
        <h2>Dunkel</h2>
        @renderStates()
    </section>
</div>

<h2>Verwendung</h2>
<pre><code>&lt;Button Variant="ButtonVariant.Primary" OnClick="Save"&gt;Speichern&lt;/Button&gt;

&lt;Button Variant="ButtonVariant.Critical" OnClick="Delete"&gt;
    &lt;Icon&gt;&lt;svg ...&gt;&lt;/svg&gt;&lt;/Icon&gt;
    Löschen
&lt;/Button&gt;

&lt;Button Variant="ButtonVariant.Secondary" Disabled="true"&gt;Abbrechen&lt;/Button&gt;
</code></pre>

@code {
    private RenderFragment renderStates() => @<text>
        <div class="vs-gallery__row">
            <Button Variant="ButtonVariant.Primary">Primär</Button>
            <Button Variant="ButtonVariant.Secondary">Sekundär</Button>
            <Button Variant="ButtonVariant.Critical">Kritisch</Button>
        </div>
        <div class="vs-gallery__row">
            <Button Variant="ButtonVariant.Primary" Disabled="true">Primär</Button>
            <Button Variant="ButtonVariant.Secondary" Disabled="true">Sekundär</Button>
            <Button Variant="ButtonVariant.Critical" Disabled="true">Kritisch</Button>
        </div>
        <div class="vs-gallery__row">
            <Button Variant="ButtonVariant.Primary">
                <Icon>
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3h11l3 3v15H5z" /></svg>
                </Icon>
                <ChildContent>Speichern</ChildContent>
            </Button>
            <Button Variant="ButtonVariant.Critical">
                <Icon>
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 7h12l-1 13H7z" /></svg>
                </Icon>
                <ChildContent>Löschen</ChildContent>
            </Button>
        </div>
    </text>;
}
