@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@using VitalSync.DesignSystem.Primitives
@inherits LayoutComponentBase
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

@if (Environment.IsDevelopment())
{
    <a href="@($"{CurrentPath}#vs-gallery-main")" class="vs-gallery__skip-link" data-enhance-nav="false">Zum Inhalt springen</a>
    <AlertBannerRegion @rendermode="InteractiveServer" />
    <div class="vs-gallery">
        <nav class="vs-gallery__nav" aria-label="Design-System-Navigation">
            <ul>
                <li><a href="design-system" aria-current="@IsCurrent("design-system")">Design System</a></li>
                <li><a href="design-system/button" aria-current="@IsCurrent("design-system/button")">Schaltfläche</a></li>
                <li><a href="design-system/input" aria-current="@IsCurrent("design-system/input")">Eingabefeld</a></li>
                <li><a href="design-system/checkbox" aria-current="@IsCurrent("design-system/checkbox")">Kontrollkästchen</a></li>
                <li><a href="design-system/radio-group" aria-current="@IsCurrent("design-system/radio-group")">Optionsfelder</a></li>
                <li><a href="design-system/toggle" aria-current="@IsCurrent("design-system/toggle")">Schalter</a></li>
                <li><a href="design-system/select" aria-current="@IsCurrent("design-system/select")">Auswahlliste</a></li>
                <li><a href="design-system/toggletip" aria-current="@IsCurrent("design-system/toggletip")">Hinweis</a></li>
                <li><a href="design-system/form" aria-current="@IsCurrent("design-system/form")">Formular</a></li>
                <li><a href="design-system/badge" aria-current="@IsCurrent("design-system/badge")">Kennzeichnung</a></li>
                <li><a href="design-system/avatar" aria-current="@IsCurrent("design-system/avatar")">Profilbild</a></li>
                <li><a href="design-system/spinner" aria-current="@IsCurrent("design-system/spinner")">Ladeanzeige</a></li>
                <li><a href="design-system/alert" aria-current="@IsCurrent("design-system/alert")">Meldung</a></li>
                <li><a href="design-system/dialog" aria-current="@IsCurrent("design-system/dialog")">Dialog</a></li>
                <li><a href="design-system/tabs" aria-current="@IsCurrent("design-system/tabs")">Registerkarten</a></li>
                <li><a href="design-system/toast" aria-current="@IsCurrent("design-system/toast")">Benachrichtigung</a></li>
                <li><a href="design-system/alert-banner" aria-current="@IsCurrent("design-system/alert-banner")">Systemmeldung</a></li>
                <li><a href="design-system/table" aria-current="@IsCurrent("design-system/table")">Tabelle</a></li>
                <li><a href="design-system/app-navigation" aria-current="@IsCurrent("design-system/app-navigation")">Navigation</a></li>
            </ul>
        </nav>
        <main id="vs-gallery-main" class="vs-gallery__content" tabindex="-1">
            @Body
        </main>
    </div>
    <ToastRegion @rendermode="InteractiveServer" />
}

@code {
    private string CurrentPath
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var end = relative.IndexOfAny(['?', '#']);
            return (end < 0 ? relative : relative[..end]).TrimEnd('/');
        }
    }

    private string? IsCurrent(string relativePath) => CurrentPath == relativePath ? "page" : null;

    protected override void OnInitialized()
    {
        if (!Environment.IsDevelopment())
        {
            Navigation.NotFound();
        }
    }
}
