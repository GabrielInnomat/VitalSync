@namespace VitalSync.DesignSystem.Primitives
@typeparam TValue
@inherits InputBase<TValue>
@implements IFormField
@attribute [CascadingTypeParameter(nameof(TValue))]
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

<div class="vs-select">
    <div class="vs-select__label-row">
        <label for="@_selectId" class="vs-select__label">
            @Label
            @if (Required)
            {
                <span class="vs-select__required-marker" aria-hidden="true">*</span>
            }
        </label>
        @if (!string.IsNullOrWhiteSpace(Info))
        {
            <Toggletip Subject="@Label" Text="@Info" />
        }
    </div>

    <div class="vs-select__field">
        <select @attributes="AdditionalAttributes"
                @ref="Element"
                id="@_selectId"
                class="@ControlClass"
                required="@Required"
                disabled="@Disabled"
                aria-invalid="@(HasError ? "true" : "false")"
                aria-describedby="@DescribedBy"
                value="@CurrentValueAsString"
                @onchange="HandleChange">
            <option value="">@Placeholder</option>
            <CascadingValue Value="this">
                @ChildContent
            </CascadingValue>
        </select>
        <span class="vs-select__icon" aria-hidden="true">
            <SystemIcon Name="SystemIconName.CaretDown" />
        </span>
    </div>

    @if (HasError)
    {
        <p id="@ErrorId" class="vs-select__error">
            <span class="vs-select__error-icon" aria-hidden="true">
                <SystemIcon Name="SystemIconName.XCircle" />
            </span>
            @CurrentErrors.First()
        </p>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <p id="@HelperId" class="vs-select__helper">@HelperText</p>
    }
</div>

@code {
    private readonly string _selectId = $"vs-select-{Guid.NewGuid():N}";
    private readonly List<SelectOption<TValue>> _options = [];

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string Placeholder { get; set; } = "Bitte wählen";

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? Info { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public ElementReference? Element { get; protected set; }

    [CascadingParameter]
    private Form? ParentForm { get; set; }

    FieldIdentifier IFormField.FieldIdentifier => FieldIdentifier;

    string IFormField.Id => _selectId;

    private string ControlClass => string.IsNullOrEmpty(CurrentValueAsString)
        ? "vs-select__control vs-select__control--empty"
        : "vs-select__control";

    private string ErrorId => $"{_selectId}-error";

    private string HelperId => $"{_selectId}-helper";

    private string? DescribedBy => HasError
        ? ErrorId
        : string.IsNullOrEmpty(HelperText) ? null : HelperId;

    private IEnumerable<string> CurrentErrors => EditContext.GetValidationMessages(FieldIdentifier);

    private bool HasError => CurrentErrors.Any();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException(
                "Select requires a visible Label; label-less selects are not supported.");
        }

        if (string.IsNullOrWhiteSpace(Placeholder))
        {
            throw new InvalidOperationException(
                "Select requires a Placeholder; it is the visible text of the empty choice.");
        }

        ParentForm?.Register(this);
    }

    public ValueTask FocusAsync() => Element is { } element ? element.FocusAsync() : ValueTask.CompletedTask;

    internal static string KeyOf(TValue? value) =>
        value is null ? "" : Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";

    internal void Register(SelectOption<TValue> option) => _options.Add(option);

    internal void Unregister(SelectOption<TValue> option) => _options.Remove(option);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            ParentForm?.Unregister(this);
        }

        base.Dispose(disposing);
    }

    private void HandleChange(ChangeEventArgs e)
    {
        var before = CurrentErrors.FirstOrDefault();
        CurrentValueAsString = e.Value as string;
        ParentForm?.ReportChange(this, before);
    }

    protected override string FormatValueAsString(TValue? value) => KeyOf(value);

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (string.IsNullOrEmpty(value) && default(TValue) is null)
        {
            result = default!;
            validationErrorMessage = "";
            return true;
        }

        var option = string.IsNullOrEmpty(value) ? null : _options.Find(candidate => KeyOf(candidate.Value) == value);
        if (option is not null)
        {
            result = option.Value;
            validationErrorMessage = "";
            return true;
        }

        result = default!;
        validationErrorMessage = $"Bitte wähle bei {Label} eine Option.";
        return false;
    }
}
