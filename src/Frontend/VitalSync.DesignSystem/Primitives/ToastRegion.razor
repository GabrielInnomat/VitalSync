@namespace VitalSync.DesignSystem.Primitives
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ToastService Service
@inject IJSRuntime JS

<div class="vs-toast-region__announcer" role="status">
    @if (_politeAnnouncement is { } polite)
    {
        <div @key="polite.Id">
            <p>@HeadingText(polite)</p>
            <p>@polite.Text</p>
        </div>
    }
</div>
<div class="vs-toast-region__announcer" role="alert">
    @if (_assertiveAnnouncement is { } assertive)
    {
        <div @key="assertive.Id">
            <p>@HeadingText(assertive)</p>
            <p>@assertive.Text</p>
        </div>
    }
</div>
@if (_toasts.Count > 0)
{
    <section class="vs-toast-region" aria-label="Benachrichtigungen">
        <ol class="vs-toast-region__list">
            @foreach (var toast in _toasts)
            {
                <li @key="toast.Id" class="vs-toast-region__item">
                    <Toast @ref="_rendered[toast.Id]"
                           Variant="toast.Variant"
                           Title="@toast.Title"
                           Text="@toast.Text"
                           OnClose="() => Close(toast.Id)"
                           OnFocus="() => Service.SetFocused(toast.Id)"
                           OnBlur="() => Service.SetFocused(null)" />
                </li>
            }
        </ol>
    </section>
}

@code {
    private const string ModulePath = "./_content/VitalSync.DesignSystem/Primitives/ToastRegion.razor.js";
    private const long MainContent = 0;

    private readonly Dictionary<long, Toast> _rendered = [];
    private IReadOnlyList<ToastMessage> _toasts = [];
    private ToastMessage? _politeAnnouncement;
    private ToastMessage? _assertiveAnnouncement;
    private long _lastSeenId;
    private long? _focusTarget;
    private Task<IJSObjectReference>? _module;

    protected override void OnInitialized()
    {
        _toasts = Service.Toasts;
        _lastSeenId = _toasts.Count > 0 ? _toasts.Max(toast => toast.Id) : 0;
        Service.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTarget is not { } target)
        {
            return;
        }

        _focusTarget = null;

        if (target != MainContent && _rendered.TryGetValue(target, out var toast))
        {
            await toast.FocusCloseButtonAsync().ConfigureAwait(true);
            return;
        }

        _module ??= JS.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask();
        var module = await _module.ConfigureAwait(true);
        await module.InvokeVoidAsync("focusMainContent").ConfigureAwait(true);
    }

    private static string HeadingText(ToastMessage toast) => $"{Toast.KindWord(toast.Variant)} – {toast.Title}";

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        _toasts = Service.Toasts;

        foreach (var toast in _toasts.Where(toast => toast.Id > _lastSeenId))
        {
            if (toast.Variant is ToastVariant.Critical)
            {
                _assertiveAnnouncement = toast;
            }
            else
            {
                _politeAnnouncement = toast;
            }

            _lastSeenId = toast.Id;
        }

        if (_politeAnnouncement is { } polite && !_toasts.Contains(polite))
        {
            _politeAnnouncement = null;
        }

        if (_assertiveAnnouncement is { } assertive && !_toasts.Contains(assertive))
        {
            _assertiveAnnouncement = null;
        }

        foreach (var id in _rendered.Keys.Where(id => _toasts.All(toast => toast.Id != id)).ToList())
        {
            _rendered.Remove(id);
        }
    }

    private void Close(long id)
    {
        var index = _toasts.ToList().FindIndex(toast => toast.Id == id);

        if (index < 0)
        {
            return;
        }

        _focusTarget = index + 1 < _toasts.Count
            ? _toasts[index + 1].Id
            : index > 0 ? _toasts[index - 1].Id : MainContent;

        Service.Close(id);
        Refresh();
    }

    public async ValueTask DisposeAsync()
    {
        Service.Changed -= OnChanged;

        if (_module is not null)
        {
            try
            {
                var module = await _module.ConfigureAwait(true);
                await module.DisposeAsync().ConfigureAwait(true);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        GC.SuppressFinalize(this);
    }
}
