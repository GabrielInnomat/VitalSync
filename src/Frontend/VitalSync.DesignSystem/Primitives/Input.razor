@namespace VitalSync.DesignSystem.Primitives
@typeparam TValue
@inherits InputBase<TValue>
@implements IFormField
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

<div class="vs-input">
    <label for="@_inputId" class="vs-input__label">
        @if (LabelIcon is not null)
        {
            <span class="vs-input__label-icon" aria-hidden="true">@LabelIcon</span>
        }
        @Label
        @if (Required)
        {
            <span class="vs-input__required-marker" aria-hidden="true">*</span>
        }
    </label>

    <div class="vs-input__field @(HasError ? "vs-input__field--error" : null) @(Disabled ? "vs-input__field--disabled" : null)">
        @if (Prefix is not null)
        {
            <span class="vs-input__affix vs-input__affix--prefix">@Prefix</span>
        }
        <input @attributes="AdditionalAttributes"
               @ref="Element"
               id="@_inputId"
               type="@EffectiveType"
               class="vs-input__control"
               placeholder="@Placeholder"
               required="@Required"
               disabled="@Disabled"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@DescribedBy"
               value="@CurrentValueAsString"
               @onchange="HandleChange"
               @oninput="HandleInput" />
        @if (Suffix is not null)
        {
            <span class="vs-input__affix vs-input__affix--suffix">@Suffix</span>
        }
        @if (Type == "password")
        {
            <button type="button"
                    class="vs-input__toggle"
                    aria-label="@ToggleAccessibleName"
                    aria-controls="@_inputId"
                    disabled="@Disabled"
                    @onclick="ToggleShowPassword">
                @ToggleText
            </button>
        }
    </div>

    @if (HasError)
    {
        <p id="@ErrorId" class="vs-input__error" role="alert">
            <span class="vs-input__error-icon" aria-hidden="true">
                <SystemIcon Name="SystemIconName.XCircle" />
            </span>
            @CurrentErrors.First()
        </p>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <p id="@HelperId" class="vs-input__helper">@HelperText</p>
    }
</div>

@code {
    private readonly string _inputId = $"vs-input-{Guid.NewGuid():N}";
    private bool _showPassword;
    private bool _validateWhileTyping;

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public RenderFragment? LabelIcon { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public RenderFragment? Prefix { get; set; }

    [Parameter]
    public RenderFragment? Suffix { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    public ElementReference? Element { get; protected set; }

    [CascadingParameter]
    private Form? ParentForm { get; set; }

    FieldIdentifier IFormField.FieldIdentifier => FieldIdentifier;

    string IFormField.Id => _inputId;

    private string EffectiveType => Type == "password" && _showPassword ? "text" : Type;

    private string ToggleText => _showPassword ? "Verbergen" : "Anzeigen";

    private string ToggleAccessibleName => $"{Label} {(_showPassword ? "verbergen" : "anzeigen")}";

    private string ErrorId => $"{_inputId}-error";

    private string HelperId => $"{_inputId}-helper";

    private string? DescribedBy => HasError
        ? ErrorId
        : string.IsNullOrEmpty(HelperText) ? null : HelperId;

    private IEnumerable<string> CurrentErrors => EditContext.GetValidationMessages(FieldIdentifier);

    private bool HasError => CurrentErrors.Any();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException(
                "Input requires a visible Label; label-less inputs are not supported.");
        }

        ParentForm?.Register(this);
    }

    public ValueTask FocusAsync() => Element is { } element ? element.FocusAsync() : ValueTask.CompletedTask;

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            ParentForm?.Unregister(this);
        }

        base.Dispose(disposing);
    }

    private void ToggleShowPassword() => _showPassword = !_showPassword;

    private void HandleChange(ChangeEventArgs e)
    {
        _validateWhileTyping = true;
        CurrentValueAsString = e.Value as string;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (_validateWhileTyping || HasError)
        {
            _validateWhileTyping = true;
            CurrentValueAsString = e.Value as string;
        }
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (BindConverter.TryConvertTo(value!, CultureInfo.CurrentCulture, out TValue? parsedValue))
        {
            result = parsedValue!;
            validationErrorMessage = "";
            return true;
        }

        result = default!;
        validationErrorMessage = $"Bitte gib bei {Label} einen gültigen Wert ein.";
        return false;
    }

    protected override string FormatValueAsString(TValue? value) => value switch
    {
        null => "",
        string stringValue => stringValue,
        IFormattable formattable => formattable.ToString(null, CultureInfo.CurrentCulture) ?? "",
        _ => value.ToString() ?? "",
    };
}
