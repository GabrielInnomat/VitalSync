@namespace VitalSync.DesignSystem.Primitives
@implements IDisposable
@inject LiveAnnouncer Announcer

<div class="vs-live-announcer" role="status" aria-atomic="false">
    @foreach (var announcement in _announcements.Where(announcement => !announcement.Urgent))
    {
        <div @key="announcement.Id">@announcement.Content</div>
    }
</div>
<div class="vs-live-announcer" role="alert" aria-atomic="false">
    @foreach (var announcement in _announcements.Where(announcement => announcement.Urgent))
    {
        <div @key="announcement.Id">@announcement.Content</div>
    }
</div>

@code {
    private IReadOnlyList<LiveAnnouncement> _announcements = [];

    protected override void OnInitialized()
    {
        _announcements = Announcer.Announcements;
        Announcer.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        _announcements = Announcer.Announcements;
        StateHasChanged();
    });

    public void Dispose() => Announcer.Changed -= OnChanged;
}
