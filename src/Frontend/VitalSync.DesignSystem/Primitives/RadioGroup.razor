@namespace VitalSync.DesignSystem.Primitives
@typeparam TValue
@inherits InputBase<TValue>
@implements IFormField
@attribute [CascadingTypeParameter(nameof(TValue))]
@using Microsoft.AspNetCore.Components.Forms

<fieldset @attributes="FieldsetAttributes"
          id="@_groupId"
          class="vs-radio-group"
          disabled="@Disabled"
          aria-labelledby="@LabelId"
          aria-describedby="@DescribedBy">
    <legend class="vs-radio-group__legend">
        <span id="@LabelId" class="vs-radio-group__label">
            @Label
            @if (Required)
            {
                <span class="vs-radio-group__required-marker" aria-hidden="true">*</span>
            }
        </span>
        @if (!string.IsNullOrWhiteSpace(Info))
        {
            <Toggletip Subject="@Label" Text="@Info" />
        }
    </legend>

    <div class="vs-radio-group__options">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>

    @if (HasError)
    {
        <p id="@ErrorId" class="vs-radio-group__error">
            <span class="vs-radio-group__error-icon" aria-hidden="true">
                <SystemIcon Name="SystemIconName.XCircle" />
            </span>
            @CurrentErrors.First()
        </p>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <p id="@HelperId" class="vs-radio-group__helper">@HelperText</p>
    }
</fieldset>

@code {
    private readonly string _groupId = $"vs-radio-group-{Guid.NewGuid():N}";
    private readonly List<RadioOption<TValue>> _options = [];

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? Info { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    private Form? ParentForm { get; set; }

    FieldIdentifier IFormField.FieldIdentifier => FieldIdentifier;

    string IFormField.Id => _options.Count > 0 ? _options[0].Id : _groupId;

    internal string Name => _groupId;

    internal bool HasError => CurrentErrors.Any();

    private string LabelId => $"{_groupId}-label";

    private string ErrorId => $"{_groupId}-error";

    private string HelperId => $"{_groupId}-helper";

    private string? DescribedBy => HasError
        ? ErrorId
        : string.IsNullOrEmpty(HelperText) ? null : HelperId;

    private IEnumerable<KeyValuePair<string, object>>? FieldsetAttributes =>
        AdditionalAttributes?.Where(attribute => attribute.Key != "aria-invalid");

    private IEnumerable<string> CurrentErrors => EditContext.GetValidationMessages(FieldIdentifier);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException(
                "RadioGroup requires a visible Label; it becomes the legend of the group.");
        }

        ParentForm?.Register(this);
    }

    public ValueTask FocusAsync()
    {
        var target = _options.Find(option => IsSelected(option.Value)) ?? _options.FirstOrDefault();
        return target is null ? ValueTask.CompletedTask : target.FocusAsync();
    }

    internal void Register(RadioOption<TValue> option) => _options.Add(option);

    internal void Unregister(RadioOption<TValue> option) => _options.Remove(option);

    internal bool IsSelected(TValue value) => EqualityComparer<TValue>.Default.Equals(CurrentValue, value);

    internal void Select(TValue value)
    {
        var before = CurrentErrors.FirstOrDefault();
        CurrentValue = value;
        ParentForm?.ReportChange(this, before);
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            ParentForm?.Unregister(this);
        }

        base.Dispose(disposing);
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage) =>
        throw new NotSupportedException($"{nameof(RadioGroup<TValue>)} takes its value from the selected option and never parses a string.");
}
