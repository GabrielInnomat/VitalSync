<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Publishes Thessera integration events to RabbitMQ and subscribes to other bounded contexts, over Wolverine. The transport is opt-in: without one, no integration event leaves the service. Not a store choice - add one of the two store packages as well.</Description>
    <PackageTags>rabbitmq;messaging;integration-events;wolverine</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GaWeCodes.Thessera.Core.Tests" />
    <InternalsVisibleTo Include="GaWeCodes.Thessera.Persistence.EfCore.Postgres.Tests" />
    <InternalsVisibleTo Include="GaWeCodes.Thessera.Persistence.Marten.Tests" />
    <InternalsVisibleTo Include="GaWeCodes.Thessera.Wolverine.Tests" />
    <InternalsVisibleTo Include="GaWeCodes.Thessera.Messaging.RabbitMq.Tests" />
    <InternalsVisibleTo Include="GaWeCodes.Thessera.Tests.PackageConventions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GaWeCodes.Thessera.Wolverine\GaWeCodes.Thessera.Wolverine.csproj" />
  </ItemGroup>

</Project>
